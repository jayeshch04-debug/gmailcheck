# Copy to .env and fill in. Real environment variables override this file.

# --- Sender (sends the test emails) --------------------------------------
# Must NOT be the master account: Gmail drops forwarded copies of mail you
# sent yourself, so every address would look dead.
#
# Option A: a separate Gmail account (use --smtp-preset gmail or SMTP_PRESET=gmail)
SMTP_PRESET=gmail
SMTP_USER=checker.account@gmail.com
SMTP_PASS=abcd efgh ijkl mnop        # Gmail app password (spaces are fine)
# SMTP_FROM=checker.account@gmail.com  # defaults to SMTP_USER
#
# Option B: your catchall domain / any SMTP server (leave SMTP_PRESET unset)
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls             # starttls | ssl | none
# SMTP_USER=check@yourdomain.com
# SMTP_PASS=secret
# SMTP_FROM=check@yourdomain.com

# --- Master mailbox (where everything forwards to) -----------------------
IMAP_USER=master@gmail.com
IMAP_PASS=wxyz wxyz wxyz wxyz        # app password of the master account
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993

# --- Optional: sender mailbox, to detect bounces (deleted accounts) -------
# BOUNCE_IMAP_USER=checker.account@gmail.com
# BOUNCE_IMAP_PASS=abcd efgh ijkl mnop
# BOUNCE_IMAP_HOST=imap.gmail.com
# BOUNCE_IMAP_PORT=993
